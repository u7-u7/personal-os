# Development credentials only; change passwords and APP_SECRET before public deployment.
POSTGRES_USER=personalos
POSTGRES_PASSWORD=personalos
POSTGRES_DB=personalos
DATABASE_URL=postgresql+psycopg://personalos:personalos@127.0.0.1:54329/personalos
REDIS_URL=redis://127.0.0.1:63799/0
APP_SECRET=replace-with-at-least-32-random-characters
ENCRYPTION_KEY=replace-with-fernet-key
WEB_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
API_URL=http://127.0.0.1:8000
COOKIE_SECURE=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
# Separate Beijing Model Studio embedding credentials; never reuse a DeepSeek key.
# Also supports qwen3.7-text-embedding; choose per account in Settings.
EMBEDDING_MODEL=qwen3.7-text-embedding-flash
EMBEDDING_DIMENSIONS=1024
# Copy the real workspace URL: https://WORKSPACE.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
MCP_ALLOWED_HOSTS=
# Code hosting tools read tokens from the environment only; never stored in the database.
GITHUB_TOKEN=
GITEE_TOKEN=
# MCP OAuth. A provider without dynamic client registration (GitHub) needs a pre-registered
# OAuth app whose callback is API_URL + /api/oauth/callback.
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
# Overrides the API_URL-derived callback when the provider sees another public address.
OAUTH_REDIRECT_URI=

# rules, llm (uses the user-configured OpenAI-compatible model), or jev
DECISION_PROVIDER=rules
TYPESAFE_API_KEY=
HY_MEMORY_ENABLED=false
APP_URL=http://localhost:3000
